<h3>ONE Webhook Settings</h3>
<p class="subtitle">Configure webhook for syncing Overtime data to ONE system</p>

<table class="list">
  <tr>
    <td class="name">
      <label for="settings_enabled">Enable Webhook</label>
    </td>
    <td>
      <%= check_box_tag 'settings[enabled]', '1', @settings['enabled'] == '1' %>
      <em class="info">When enabled, overtime logs will be sent to ONE system</em>
    </td>
  </tr>

  <tr>
    <td class="name">
      <label for="settings_webhook_url">Webhook URL <span class="required">*</span></label>
    </td>
    <td>
      <%= text_field_tag 'settings[webhook_url]', @settings['webhook_url'], :size => 80 %>
      <em class="info">Example: http://your-server:8000/api/pms/update-logtime</em>
    </td>
  </tr>

  <tr>
    <td class="name">
      <label for="settings_webhook_secret">Webhook Secret</label>
    </td>
    <td>
      <%= text_field_tag 'settings[webhook_secret]', @settings['webhook_secret'], :size => 60 %>
      <em class="info">Secret key for HMAC-SHA256 signature verification</em>
    </td>
  </tr>
</table>

<hr/>

<h4>Information</h4>
<ul>
  <li><strong>Applies to:</strong> All projects (global setting)</li>
  <li><strong>Trigger:</strong> When user logs time with Activity = "Overtime"</li>
  <li><strong>Signature Header:</strong> <code>X-Webhook-Signature</code> (HMAC-SHA256)</li>
  <li><strong>Event Header:</strong> <code>X-Webhook-Event: overtime_logged</code></li>
</ul>
